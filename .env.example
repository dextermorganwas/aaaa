# ============================================================================
# stremio-art-bridge configuration
# Copy this file to ".env" next to docker-compose.yml and fill in your values.
# ============================================================================

# --- Server ---
PORT=8990
# Public base URL you'll use in AIOMetadata's custom-URL fields, e.g. https://art.example.com
# (informational only right now - not required for the app to function)
BASE_URL=

# Protect the /admin dashboard with HTTP Basic Auth. Leave both blank to leave it open
# (fine on a private LAN; set these if this container is reachable from the internet).
ADMIN_USER=
ADMIN_PASSWORD=

LOG_LEVEL=info

# --- TMDB ---
# Either a v3 API key OR a v4 Read Access Token works. If both are set, the bearer token wins.
TMDB_API_KEY=
TMDB_BEARER_TOKEN=

# --- TVDB ---
# TVDB v4 API key (from https://thetvdb.com/dashboard/account/apikey). Leave TVDB_API_KEY blank
# to disable TVDB entirely - the chain will simply skip every TVDB step.
TVDB_API_KEY=
# Only needed if your TVDB API key is a "subscriber PIN" model key.
TVDB_SUBSCRIBER_PIN=

# --- Image sizes ---
# TMDB poster size: w92, w154, w185, w342, w500, w780, or original
TMDB_POSTER_SIZE=w780
# Backdrops/logos default to "original" per your spec; TMDB also accepts w300/w780/w1280 for backdrops
# and w45/w92/w154/w185/w300/w500 for logos if you want to save bandwidth.
TMDB_BACKDROP_SIZE=original
TMDB_LOGO_SIZE=original

# --- Cache lifetimes (days) ---
# ThePosterDB hits are ALWAYS cached forever regardless of these settings, per your spec.
CACHE_TTL_DAYS_TMDB=30
CACHE_TTL_DAYS_TVDB=30
CACHE_TTL_DAYS_METAHUB=14
# How long a confirmed "nothing found anywhere" result is remembered before retrying - stops a
# bad/mismatched id from hitting every provider on every single request.
NEGATIVE_CACHE_TTL_HOURS=12

# --- Resource usage / concurrency ---
# Global cap on simultaneous outbound requests to TMDB/TVDB/TPDB/Metahub combined.
# Lower this on a low-power box (e.g. Raspberry Pi); raise it on a beefier server.
MAX_CONCURRENT_FETCHES=8
# How many "finish this in the background" jobs (e.g. slow ThePosterDB backfills) can run at once.
BACKGROUND_JOB_CONCURRENCY=2

# --- Per-provider timeouts (ms) ---
# If ThePosterDB doesn't respond within this window, the current request moves on to the next
# provider immediately, and the ThePosterDB lookup keeps running in the background so future
# requests for that item get served the ThePosterDB art once it's found.
TPDB_TIMEOUT_MS=4000
TMDB_TIMEOUT_MS=6000
TVDB_TIMEOUT_MS=6000
METAHUB_TIMEOUT_MS=5000

# If false (recommended, and the default), no request ever waits on ThePosterDB - it's kicked
# off in the background immediately and the response falls straight through to TMDB/TVDB/Metahub.
# Set to true to have the FIRST request for an item wait up to TPDB_TIMEOUT_MS for ThePosterDB
# before falling through instead.
TPDB_INLINE_ENABLED=false

# How many extra ("other language/variation") ThePosterDB candidates the admin "browse all
# options" view shows beyond the primary English/Original set. Purely a display cap now (the
# scraper requests the site's own already-filtered page, so this doesn't affect request count).
TPDB_MAX_CANDIDATES=24
# ThePosterDB has no official API and no rate-limit contract, so it gets its own, lower
# concurrency cap - separate from MAX_CONCURRENT_FETCHES, which also serves TMDB/TVDB and can
# stay higher.
TPDB_MAX_CONCURRENT=2
# Minimum spacing (ms) between consecutive ThePosterDB requests, on top of the concurrency cap
# above - this is what actually bounds total throughput over time. Confirmed in practice: a
# burst of several items needing a ThePosterDB check at once (e.g. right after a restart) can
# still trigger a 429 "Too Many Requests" even with these limits, especially on the image
# download endpoint - a 429/503 is now retried automatically with backoff (honoring the
# server's Retry-After header when it sends one) rather than treated as a failure, so this
# setting controls how OFTEN that happens, not whether it's handled gracefully when it does.
# Raise this further if you still see 429s in the logs.
TPDB_MIN_REQUEST_INTERVAL_MS=500

# --- ThePosterDB "low-effort template" style check ---
# Detects the common style of a plain/textless promo image framed by a thin uniform (usually
# white) border. When detected, the next candidate is tried instead; if every checked candidate
# matches, whatever art was already being served is kept rather than replaced with a low-effort
# pick. Requires the "sharp" image library (installed automatically) - if it's ever unavailable
# for some reason, this check is skipped with a warning rather than breaking anything.
TPDB_STYLE_CHECK_ENABLED=true
# How many top (Downloads-sorted) candidates to download and check per title before giving up -
# each one costs an extra image download, so keep this modest.
TPDB_STYLE_CHECK_MAX_CANDIDATES=5
# Fraction of pixels in each edge strip that must be near-white for that edge to count as
# "bordered" (needs 3 of 4 edges to flag the image as framed). Lower = more lenient/eager. This
# is a heuristic tuned by reasoning about examples, not validated against a large real-world
# sample - watch the logs for "looks like the low-effort template style" lines (they include the
# measured edge count) and adjust this if it's too eager or too lax.
TPDB_STYLE_BORDER_THRESHOLD=0.85

# Some titles have more than one matching disambiguation page on ThePosterDB (a duplicate/near-
# duplicate entry, sometimes an empty one) - this many are tried in order before giving up, so a
# dead first match doesn't block a working second one.
TPDB_MAX_ALTERNATE_TITLE_PAGES=3
# How many pages of ThePosterDB search results to check before giving up on finding a title.
TPDB_MAX_SEARCH_PAGES=2

# How long a confirmed "ThePosterDB has nothing qualifying for this title" result is remembered
# before it's tried again (TPDB's catalog grows slowly, so this can be long).
TPDB_NEGATIVE_CACHE_DAYS=3
# How long to back off ThePosterDB after it errors/times out, before trying again.
TPDB_ERROR_BACKOFF_MINUTES=20

# --- Placeholder art ---
# If nothing at all is found, redirect to these instead of returning a 404 (recommended, so
# Stremio never shows a broken-image icon). Leave blank to just 404.
SERVE_PLACEHOLDER_ON_404=true
PLACEHOLDER_POSTER_URL=
PLACEHOLDER_BACKDROP_URL=
PLACEHOLDER_LOGO_URL=

# --- Storage paths (leave as-is for Docker; only change for bare-metal runs) ---
DATA_DIR=/data

# --- Container user (Docker only) ---
# The container starts as root just long enough to fix ownership of the bind-mounted ./data
# folder, then drops to this uid:gid to actually run the app. Match your own user
# (`id -u` / `id -g` on the host) if you want files under ./data owned by you; otherwise the
# defaults below are fine and match the first regular user on most Linux distros.
PUID=1000
PGID=1000
