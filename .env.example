# ============================================================================
# stremio-art-bridge configuration
# Copy this file to ".env" next to docker-compose.yml and fill in your values.
# ============================================================================

# --- Server ---
PORT=8990
# Public base URL you'll use in AIOMetadata's custom-URL fields, e.g. https://art.example.com
# (informational only right now - not required for the app to function)
BASE_URL=

# Protect the /admin dashboard with HTTP Basic Auth. Leave both blank to leave it open
# (fine on a private LAN; set these if this container is reachable from the internet).
ADMIN_USER=
ADMIN_PASSWORD=

LOG_LEVEL=info

# --- TMDB ---
# Either a v3 API key OR a v4 Read Access Token works. If both are set, the bearer token wins.
TMDB_API_KEY=
TMDB_BEARER_TOKEN=

# --- TVDB ---
# TVDB v4 API key (from https://thetvdb.com/dashboard/account/apikey). Leave TVDB_API_KEY blank
# to disable TVDB entirely - the chain will simply skip every TVDB step.
TVDB_API_KEY=
# Only needed if your TVDB API key is a "subscriber PIN" model key.
TVDB_SUBSCRIBER_PIN=

# --- Image sizes ---
# TMDB poster size: w92, w154, w185, w342, w500, w780, or original
TMDB_POSTER_SIZE=w780
# Backdrops/logos default to "original" per your spec; TMDB also accepts w300/w780/w1280 for backdrops
# and w45/w92/w154/w185/w300/w500 for logos if you want to save bandwidth.
TMDB_BACKDROP_SIZE=original
TMDB_LOGO_SIZE=original

# --- Cache lifetimes (days) ---
# ThePosterDB hits are ALWAYS cached forever regardless of these settings, per your spec.
CACHE_TTL_DAYS_TMDB=30
CACHE_TTL_DAYS_TVDB=30
CACHE_TTL_DAYS_METAHUB=14

# --- Resource usage / concurrency ---
# Global cap on simultaneous outbound requests to TMDB/TVDB/TPDB/Metahub combined.
# Lower this on a low-power box (e.g. Raspberry Pi); raise it on a beefier server.
MAX_CONCURRENT_FETCHES=8
# How many "finish this in the background" jobs (e.g. slow ThePosterDB backfills) can run at once.
BACKGROUND_JOB_CONCURRENCY=2

# --- Per-provider timeouts (ms) ---
# If ThePosterDB doesn't respond within this window, the current request moves on to the next
# provider immediately, and the ThePosterDB lookup keeps running in the background so future
# requests for that item get served the ThePosterDB art once it's found.
TPDB_TIMEOUT_MS=4000
TMDB_TIMEOUT_MS=6000
TVDB_TIMEOUT_MS=6000
METAHUB_TIMEOUT_MS=5000

# How many candidate ThePosterDB sets to open per title before giving up (each is one extra
# HTTP request to theposterdb.com). Higher = more thorough but slower/heavier scraping.
TPDB_MAX_CANDIDATES=10

# --- Placeholder art ---
# If nothing at all is found, redirect to these instead of returning a 404 (recommended, so
# Stremio never shows a broken-image icon). Leave blank to just 404.
SERVE_PLACEHOLDER_ON_404=true
PLACEHOLDER_POSTER_URL=
PLACEHOLDER_BACKDROP_URL=
PLACEHOLDER_LOGO_URL=

# --- Storage paths (leave as-is for Docker; only change for bare-metal runs) ---
DATA_DIR=/data
